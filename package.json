{
  "name": "jev-sim",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke": "node --experimental-strip-types --env-file=.env experiments/evaluations/smoke.ts",
    "sensitivity": "node --experimental-strip-types --env-file=.env experiments/evaluations/sensitivity.ts",
    "baseline": "node --experimental-strip-types --env-file=.env src/main.ts",
    "check": "biome check --write . && tsc && tsc -p viewer",
    "lint": "biome check . && tsc && tsc -p viewer",
    "viewer": "vite viewer",
    "viewer:smoke": "node --experimental-strip-types viewer/smoke/smoke.mjs",
    "viewer:build": "vite build viewer",
    "fork": "node --experimental-strip-types --env-file=.env experiments/fork.ts",
    "checks": "node --experimental-strip-types --env-file=.env experiments/evaluations/checks.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage tests/*.test.ts",
    "verify": "pnpm lint && pnpm test && pnpm docs:check && pnpm viewer:smoke && pnpm viewer:build",
    "docs:generate": "node --experimental-strip-types scripts/docs/scenario.ts",
    "docs:check": "node --experimental-strip-types scripts/docs/scenario.ts --check"
  },
  "dependencies": {
    "ai": "^7.0.109",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
